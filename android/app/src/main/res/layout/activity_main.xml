<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦"
                android:textSize="32sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storefy - Celular Casa"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transmite avisos a la tienda por internet"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta de Permisos -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado del Servicio"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPermissionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="⏳ Verificando permisos..."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnGrantPermission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="1. Activar Acceso a Notificaciones"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/primary" />

                <Button
                    android:id="@+id/btnBatteryOptimization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="2. Desactivar Ahorro de Batería"
                    android:textAllCaps="false"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="@color/text_primary"
                    app:strokeColor="#334155" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Filtro de Notificaciones (NUEVA) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtro de Notificaciones"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Selecciona qué apps tienen permiso de enviar avisos a la web"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Selector de Modo -->
                <RadioGroup
                    android:id="@+id/rgFilterMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbSelectedApps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎯 Solo aplicaciones seleccionadas (Recomendado)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbAllApps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌐 Enviar TODAS las aplicaciones del celular"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </RadioGroup>

                <!-- Contenedor de Apps Seleccionadas -->
                <LinearLayout
                    android:id="@+id/layoutFilterOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:background="#0A1120"
                    android:padding="10dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apps de Entregas &amp; Mensajería Rápida:"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <CheckBox
                        android:id="@+id/cbRappi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛵 Rappi (Reparto &amp; Entregas)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbPedidosYa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍔 PedidosYa"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbMercadoLibre"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 MercadoLibre (Envíos &amp; Compras)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbAmazon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Amazon Compras"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbUber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚗 Uber / Uber Eats / DiDi"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbWhatsApp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 WhatsApp &amp; WhatsApp Business"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <CheckBox
                        android:id="@+id/cbTelegram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✈️ Telegram"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="false" />

                    <CheckBox
                        android:id="@+id/cbSms"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Mensajes SMS de texto"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:checked="true" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1E293B"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnChooseMoreApps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🔍 Elegir de mis apps instaladas..."
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:textColor="#38BDF8"
                        app:strokeColor="#38BDF8" />

                    <TextView
                        android:id="@+id/tvCustomAppsSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 apps adicionales seleccionadas"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de Configuración del Servidor -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="12dp"
            app:strokeColor="#334155"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conexión con la Tienda"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="URL pública del servidor web"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="#0F172A"
                    android:padding="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:hint="https://tu-tienda.app.github.dev"
                    android:inputType="textUri"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Clave de Seguridad (API Key)"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="#0F172A"
                    android:padding="10dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:hint="tienda123"
                    android:inputType="text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSaveConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="💾 Guardar Cambios y Filtros"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/primary" />

                <Button
                    android:id="@+id/btnTestNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="⚡ Probar Notificación de Entrega"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/success" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Registro de Eventos en Pantalla -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro de Actividad:"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:background="#050B14"
            android:padding="10dp"
            android:textColor="#38BDF8"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:scrollbars="vertical"
            android:text="[Iniciado] Esperando eventos..." />

    </LinearLayout>
</ScrollView>
